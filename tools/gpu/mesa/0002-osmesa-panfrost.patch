 struct pipe_screen *
 osmesa_create_screen(void)
 {
+#if defined(__APPLE__)
+   /* On iOS the GPU is the Mali behind the S8Mali user client. Try it
+    * first and fall back to the software rasteriser if it is not there. */
+   {
+      int fd = s8_drm_open();
+      if (fd >= 0) {
+         struct pipe_screen *mali =
+            panfrost_drm_screen_create(fd, NULL);
+         if (mali != NULL)
+            return debug_screen_wrap(mali);
+         close(fd);
+      }
+   }
+#endif
    struct sw_winsys *winsys;
    struct pipe_screen *screen;
 
